rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTherapyMemoryDocument() {
      return request.resource.data.keys().hasOnly([
          'schema', 'schemaVersion', 'appVersion', 'version', 'updatedAt', 'updatedBy', 'items'
        ])
        && request.resource.data.schema == 'temperaturna-lista-therapy-favorites-v3'
        && request.resource.data.schemaVersion == 3
        && request.resource.data.version is int
        && request.resource.data.version > 0
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 250;
    }

    // Shared, non-clinical therapy templates. Every signed-in user can manage
    // this one document; patient documents remain inaccessible below.
    match /appConfig/sharedTherapyFavoritesV2 {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidTherapyMemoryDocument()
        && request.resource.data.version == 1;
      allow update: if isSignedIn()
        && isValidTherapyMemoryDocument()
        && (
          (!resource.data.keys().hasAny(['version']) && request.resource.data.version == 1)
          || request.resource.data.version == resource.data.version + 1
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
